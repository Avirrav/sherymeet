NODE_ENV=development
# LiveKit Server Configuration
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_API_URL=http://localhost:3000

# AWS Credentials for Transcribe and S3 Egress
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-2
AWS_TRANSCRIBE_REGION=ap-south-1
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name
ROOM_EMPTY_TIMEOUT=300

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/sherymeet

# Redis (recommended in production; REQUIRED when running more than one
# instance). Backs rate limiting and replay/nonce protection. Without it,
# those protections are per-process (in-memory) only.
REDIS_URL=redis://localhost:6379

# LiveKit access token lifetime (host + participant). Increase for long meetings.
LIVEKIT_TOKEN_TTL=2h

# Days to keep security audit logs before the MongoDB TTL index prunes them.
AUDIT_LOG_TTL_DAYS=90

# Log output: json (default in production) | pretty (default in development)
# LOG_FORMAT=json

# API Security and Encryption Configuration
# 32-byte key for local AES-256-GCM fallback encryption
ENCRYPTION_MASTER_KEY=your_32_byte_master_encryption_key_here

# AWS KMS Configuration (Optional - leave empty to use local encryption fallback)
AWS_KMS_KEY_ID=arn:aws:kms:region:account:key/key-uuid



# Exaples for .env.deploy
AWS_REGION=ap-south-2
AWS_VPC_NAME=your-vpc-name

LIVEKIT_SECURITY_GROUP_NAME=your_livekit_security_group
SHERYMEET_SECURITY_GROUP_NAME=your_sherymeet_security_group
REDIS_SECURITY_GROUP_NAME=your_redis_security_group

REDIS_INSTANCE_TYPE="t3.large"
REDIS_INSTANCE_NAME="your_redis_instance_name"
REDIS_PASSWORD="XXXXXXXXXXXXXXXX"

LIVEKIT_DOMAIN=sherymeet.yourdomain.com
LIVEKIT_TURN_DOMAIN=turn.yourdomain.com
LIVEKIT_WHIP_DOMAIN=whip.yourdomain.com
LIVEKIT_WEBHOOK_DOMAIN=webhook.yourdomain.com
LIVEKIT_INSTANCE_TYPE="t3.large"
LIVEKIT_INSTANCE_NAME="your_livekit_instance_name"