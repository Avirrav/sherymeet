NODE_ENV=development
# LiveKit Server Configuration
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_API_URL=http://localhost:3000

# AWS Credentials for Transcribe and S3 Egress
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-2
AWS_TRANSCRIBE_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name
ROOM_EMPTY_TIMEOUT=300

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/sherymeet

# API Security and Encryption Configuration
# 32-byte key for local AES-256-GCM fallback encryption
ENCRYPTION_MASTER_KEY=your_32_byte_master_encryption_key_here

# AWS KMS Configuration (Optional - leave empty to use local encryption fallback)
AWS_KMS_KEY_ID=arn:aws:kms:region:account:key/key-uuid
