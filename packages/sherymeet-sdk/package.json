{
  "name": "@sherymeet/embed-sdk",
  "version": "0.1.0",
  "description": "Embed Sherymeet video meetings in any web app via iframe with a typed event/command bridge.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "sherymeet",
    "video",
    "conferencing",
    "livekit",
    "embed",
    "sdk"
  ],
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
